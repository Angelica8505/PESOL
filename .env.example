# PESOLUTION Environment Variables
# These are for XAMPP / Hostinger manual setup

# Database Configuration
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=pesolution

# Power BI
# The Publish to Web URL for your Power BI report
POWER_BI_URL=https://app.powerbi.com/view?r=eyJrIjoi...

# Gemini AI (roadmaps, skill recommendations — server-side only)
GEMINI_API_KEY=

# Node Environment (optional, for dev server)
NODE_ENV=development
